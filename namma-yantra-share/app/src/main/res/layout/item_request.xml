<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvFarmerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Farmer: Basavaraj"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFarmerContact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contact: 9876543210"
            android:textSize="12sp"
            android:textColor="#666666" />

        <TextView
            android:id="@+id/tvFarmerAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Address: Village Road"
            android:textSize="12sp"
            android:textColor="#666666" />

        <TextView
            android:id="@+id/tvDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Machine: Mahindra 575 | Duration: 5 hrs"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvRequestTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Time: 08:00 - 12:00 | May 15, 2026"
            android:textSize="12sp"
            android:textColor="#999999" />

        <LinearLayout
            android:id="@+id/llActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Confirm"
                app:backgroundTint="@color/status_accepted" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReject"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Reject"
                android:textColor="@color/status_declined"
                app:strokeColor="@color/status_declined" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/llAcceptedOwnerActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCallFarmer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Call Farmer"
                android:backgroundTint="#E3F2FD"
                android:textColor="#1976D2"
                app:cornerRadius="8dp" />

            <TextView
                android:id="@+id/tvFarmerConfirmStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#FFF3E0"
                android:padding="8dp"
                android:text="Waiting for Farmer to confirm..."
                android:textColor="#E65100"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFinalize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="FINALIZE & START RENT"
                android:backgroundTint="@color/agri_green"
                android:visibility="gone"
                app:cornerRadius="8dp" />
            
            <TextView
                android:id="@+id/tvFinalized"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#E8F5E9"
                android:padding="8dp"
                android:text="BOOKING FINALIZED & SUCCESSFUL"
                android:textColor="#2E7D32"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="ACCEPTED"
            android:textColor="@color/status_accepted"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOwnerMarkDone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="MARK WORK AS DONE"
            android:visibility="gone"
            android:backgroundTint="#5D4037"
            app:cornerRadius="8dp" />

        <TextView
            android:id="@+id/tvWorkDone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FAFAFA"
            android:padding="8dp"
            android:text="WORK COMPLETED"
            android:textColor="#9E9E9E"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvOwnerReviewDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="8dp"
            android:background="#FFF9C4"
            android:visibility="gone"
            android:textSize="10sp"
            android:textStyle="italic" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
